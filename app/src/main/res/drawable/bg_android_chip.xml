<?xml version="1.0" encoding="utf-8"?>
<!-- Cyan-green badge for Android Dev chip -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="135"
        android:startColor="#003D35"
        android:centerColor="#00695C"
        android:endColor="#00BFA5"
        android:type="linear"/>
    <corners android:radius="24dp"/>
    <stroke android:width="1.2dp" android:color="#3DDC84"/>
</shape>
