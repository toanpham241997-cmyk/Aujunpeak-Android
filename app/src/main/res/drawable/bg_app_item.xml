<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#B31A1A1A"/>
            <corners android:radius="12dp"/>
            <stroke android:width="1dp" android:color="#227E9CFF"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:type="radial"
                android:gradientRadius="80dp"
                android:centerX="0.15"
                android:centerY="0.2"
                android:startColor="#20FFFFFF"
                android:endColor="#00000000"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
</layer-list>
