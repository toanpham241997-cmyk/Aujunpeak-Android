<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#CC1A1A2E"
                android:endColor="#CC12121C"
                android:type="linear"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#00000000"/>
            <stroke android:width="1dp" android:color="#337E9CFF"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:type="radial"
                android:gradientRadius="140dp"
                android:centerX="0.2"
                android:centerY="0.1"
                android:startColor="#30FFFFFF"
                android:endColor="#00000000"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
</layer-list>
