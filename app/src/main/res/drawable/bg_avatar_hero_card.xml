<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#CC140A14"/>
            <corners android:radius="22dp"/>
            <stroke android:width="1.5dp" android:color="#447E9CFF"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#227E9CFF"
                android:centerColor="#11880000"
                android:endColor="#00000000"
                android:type="linear"/>
            <corners android:radius="22dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:type="radial"
                android:gradientRadius="200dp"
                android:centerX="0.5"
                android:centerY="0.1"
                android:startColor="#30FFFFFF"
                android:endColor="#00000000"/>
            <corners android:radius="22dp"/>
        </shape>
    </item>
</layer-list>
