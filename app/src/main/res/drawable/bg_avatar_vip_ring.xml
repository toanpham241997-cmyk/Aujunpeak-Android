<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer golden glow -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="sweep"
                android:startColor="#FFD700"
                android:centerColor="#FFA000"
                android:endColor="#FFD700"/>
        </shape>
    </item>
    <!-- Mid ring -->
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="#FF8C00"/>
        </shape>
    </item>
    <!-- Inner dark -->
    <item android:top="5dp" android:left="5dp" android:right="5dp" android:bottom="5dp">
        <shape android:shape="oval">
            <solid android:color="#0D0D00"/>
        </shape>
    </item>
</layer-list>
