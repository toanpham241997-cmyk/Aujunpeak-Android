<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#B0181022"/>
            <corners android:radius="20dp"/>
            <stroke android:width="1.5dp" android:color="#667E9CFF"/>
        </shape>
    </item>
    <item android:bottom="0dp" android:left="0dp" android:right="0dp" android:top="0dp">
        <shape>
            <gradient
                android:angle="45"
                android:startColor="#337E9CFF"
                android:centerColor="#0AFF5252"
                android:endColor="#00000000"
                android:type="radial"
                android:gradientRadius="250"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
    <item android:bottom="0dp" android:left="0dp" android:right="0dp" android:top="0dp">
        <shape>
            <gradient
                android:type="radial"
                android:gradientRadius="160dp"
                android:centerX="0.18"
                android:centerY="0.1"
                android:startColor="#33FFFFFF"
                android:endColor="#00000000"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
</layer-list>
