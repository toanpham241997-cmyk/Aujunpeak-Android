<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#CC1A0800"/>
            <corners android:radius="18dp"/>
            <stroke android:width="2dp" android:color="#CCFF6D00"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#30FF9800"
                android:endColor="#00000000"
                android:type="linear"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:type="radial"
                android:gradientRadius="140dp"
                android:centerX="0.2"
                android:centerY="0.15"
                android:startColor="#20FFFFFF"
                android:endColor="#00000000"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
</layer-list>
