<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#CC0D1F3D"/>
            <corners android:radius="18dp"/>
            <stroke android:width="1.5dp" android:color="#661877F2"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#331877F2"
                android:endColor="#00000000"
                android:type="linear"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:type="radial"
                android:gradientRadius="140dp"
                android:centerX="0.2"
                android:centerY="0.1"
                android:startColor="#301877F2"
                android:endColor="#00000000"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
</layer-list>
