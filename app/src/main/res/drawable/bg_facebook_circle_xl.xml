<?xml version="1.0" encoding="utf-8"?>
<!-- Large circular Facebook button background -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer glow ring -->
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="oval">
            <solid android:color="#00000000"/>
            <stroke android:width="2dp" android:color="#501877F2"/>
        </shape>
    </item>
    <!-- Main blue gradient circle -->
    <item android:left="8dp" android:top="8dp" android:right="8dp" android:bottom="8dp">
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#E81877F2"
                android:endColor="#E80D5FC0"
                android:type="linear"/>
        </shape>
    </item>
    <!-- White sheen top-left -->
    <item android:left="8dp" android:top="8dp" android:right="8dp" android:bottom="8dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="60dp"
                android:centerX="0.25"
                android:centerY="0.2"
                android:startColor="#22FFFFFF"
                android:endColor="#00000000"/>
        </shape>
    </item>
    <!-- Inner stroke -->
    <item android:left="8dp" android:top="8dp" android:right="8dp" android:bottom="8dp">
        <shape android:shape="oval">
            <solid android:color="#00000000"/>
            <stroke android:width="1.5dp" android:color="#661E88FF"/>
        </shape>
    </item>
</layer-list>
