<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#B8161616"/>
            <corners android:radius="14dp"/>
            <stroke android:width="1dp" android:color="#3EFF1744"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="180"
                android:startColor="#14FF1744"
                android:endColor="#00000000"
                android:type="linear"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
</layer-list>
