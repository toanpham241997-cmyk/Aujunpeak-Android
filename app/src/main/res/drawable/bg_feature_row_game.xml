<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="0"
                android:startColor="#3A2A210A"
                android:centerColor="#33FFB300"
                android:endColor="#1A150F06"
                android:type="linear"/>
            <corners android:radius="24dp"/>
            <stroke android:width="1.8dp" android:color="#99FFC400"/>
        </shape>
    </item>
    <item android:left="0dp" android:top="0dp" android:right="0dp" android:bottom="0dp">
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#55FFD600"
                android:endColor="#00000000"
                android:type="linear"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>
    <item android:left="0dp" android:top="0dp" android:right="0dp" android:bottom="0dp">
        <shape>
            <gradient
                android:type="radial"
                android:gradientRadius="130dp"
                android:centerX="0.15"
                android:centerY="0.15"
                android:startColor="#3AFFFFFF"
                android:endColor="#00000000"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>
</layer-list>
