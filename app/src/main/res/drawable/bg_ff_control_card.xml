<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#141E35"
                android:centerColor="#16253A"
                android:endColor="#101A2C" />
            <stroke
                android:width="1dp"
                android:color="#7A6DEBFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="320dp"
                android:centerX="0.0"
                android:centerY="0.08"
                android:startColor="#244AE3FF"
                android:endColor="#00000000" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="260dp"
                android:centerX="1.0"
                android:centerY="1.0"
                android:startColor="#1831C7FF"
                android:endColor="#00000000" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#16FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="23dp" />
        </shape>
    </item>
</layer-list>
