<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#FF6D00"
                android:centerColor="#E53935"
                android:endColor="#7E9CFF"
                android:type="sweep"/>
            <stroke android:width="2dp" android:color="#FFAA00"/>
        </shape>
    </item>
    <item android:bottom="4dp" android:left="4dp" android:right="4dp" android:top="4dp">
        <shape android:shape="oval">
            <solid android:color="#1A0A0A"/>
        </shape>
    </item>
</layer-list>
