<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted glass card — red accent tint (Home RAM, general) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base: semi-transparent dark so GIF background shows through -->
    <item>
        <shape>
            <solid android:color="#B2100E18"/>
            <corners android:radius="16dp"/>
            <stroke android:width="1dp" android:color="#3AFF1744"/>
        </shape>
    </item>
    <!-- Red energy wash from top-left -->
    <item>
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#20FF1744"
                android:endColor="#00000000"
                android:type="linear"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
    <!-- Glass highlight sheen at top-left corner -->
    <item>
        <shape>
            <gradient
                android:type="radial"
                android:gradientRadius="200dp"
                android:centerX="0.12"
                android:centerY="0.05"
                android:startColor="#30FFFFFF"
                android:endColor="#00000000"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
    <!-- Subtle bottom glow for depth -->
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#00000000"
                android:endColor="#15FF1744"
                android:type="linear"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
</layer-list>
