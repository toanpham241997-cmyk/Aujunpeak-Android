<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted glass card — cyan accent tint (Home CPU) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#F0070707"/>
            <corners android:radius="16dp"/>
            <stroke android:width="1dp" android:color="#667E9CFF"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#1A7E9CFF"
                android:endColor="#00000000"
                android:type="linear"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:type="radial"
                android:gradientRadius="200dp"
                android:centerX="0.12"
                android:centerY="0.05"
                android:startColor="#2EFFFFFF"
                android:endColor="#00000000"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#00000000"
                android:endColor="#127E9CFF"
                android:type="linear"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
</layer-list>
