<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted glass card — gold accent tint (Home Quick Controls) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#B2141008"/>
            <corners android:radius="16dp"/>
            <stroke android:width="1dp" android:color="#38FFD700"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#1AFFD700"
                android:endColor="#00000000"
                android:type="linear"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:type="radial"
                android:gradientRadius="200dp"
                android:centerX="0.12"
                android:centerY="0.05"
                android:startColor="#2EFFFFFF"
                android:endColor="#00000000"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#00000000"
                android:endColor="#12FFB300"
                android:type="linear"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
</layer-list>
