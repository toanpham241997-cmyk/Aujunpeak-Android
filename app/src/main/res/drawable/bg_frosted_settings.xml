<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted glass card — blue-purple accent (Settings cards) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#B20E0F20"/>
            <corners android:radius="20dp"/>
            <stroke android:width="1dp" android:color="#35884DFF"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#18884DFF"
                android:endColor="#00000000"
                android:type="linear"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:type="radial"
                android:gradientRadius="220dp"
                android:centerX="0.12"
                android:centerY="0.05"
                android:startColor="#28FFFFFF"
                android:endColor="#00000000"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
</layer-list>
