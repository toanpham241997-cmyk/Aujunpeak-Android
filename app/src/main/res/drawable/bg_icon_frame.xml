<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#CC2A1A1A"
                android:endColor="#CC1A0A0A"
                android:type="linear"/>
            <corners android:radius="18dp"/>
            <stroke android:width="1.5dp" android:color="#7E9CFF"/>
        </shape>
    </item>
    <item android:bottom="0dp" android:left="0dp" android:right="0dp" android:top="0dp">
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#337E9CFF"
                android:endColor="#00000000"
                android:type="linear"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
</layer-list>
