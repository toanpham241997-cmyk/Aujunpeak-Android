<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Glow layer -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#227E9CFF"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
    <!-- Main badge -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#2A7E9CFF"
                android:endColor="#1A8B0000"
                android:angle="135"/>
            <corners android:radius="20dp"/>
            <stroke android:width="1dp" android:color="#667E9CFF"/>
        </shape>
    </item>
</layer-list>
