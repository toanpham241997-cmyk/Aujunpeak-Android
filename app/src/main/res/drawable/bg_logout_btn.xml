<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient
                android:angle="90"
                android:startColor="#CC1111"
                android:endColor="#8B0000"
                android:type="linear"/>
            <corners android:radius="16dp"/>
            <stroke android:width="1.5dp" android:color="#FF5252"/>
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape>
                    <solid android:color="#1A0000"/>
                    <corners android:radius="16dp"/>
                    <stroke android:width="1.5dp" android:color="#AA1744"/>
                </shape>
            </item>
            <item>
                <shape>
                    <gradient
                        android:angle="135"
                        android:startColor="#22FF5C72"
                        android:endColor="#00000000"
                        android:type="linear"/>
                    <corners android:radius="16dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
