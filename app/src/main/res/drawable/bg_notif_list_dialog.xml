<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#F60A1020" android:centerColor="#F8131C33" android:endColor="#F50A1326"/>
            <corners android:topLeftRadius="26dp" android:topRightRadius="26dp"/>
            <stroke android:width="1dp" android:color="#4A5D8B"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:gradientRadius="300dp" android:centerX="0.0" android:centerY="0.0" android:startColor="#1A57D9FF" android:endColor="#00000000"/>
            <corners android:topLeftRadius="26dp" android:topRightRadius="26dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:gradientRadius="260dp" android:centerX="1.0" android:centerY="1.0" android:startColor="#14937CFF" android:endColor="#00000000"/>
            <corners android:topLeftRadius="26dp" android:topRightRadius="26dp"/>
        </shape>
    </item>
</layer-list>
