<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#171F36" android:centerColor="#121A2B" android:endColor="#0C1422"/>
            <corners android:radius="16dp"/>
            <stroke android:width="1dp" android:color="#355987"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:gradientRadius="180dp" android:centerX="0.0" android:centerY="0.0" android:startColor="#153ED8FF" android:endColor="#00000000"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
</layer-list>
