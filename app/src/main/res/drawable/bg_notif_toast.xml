<?xml version="1.0" encoding="utf-8"?>
<!-- Toast card: dark với viền trái cam, bo góc, mờ nhẹ -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Viền trái cam -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF9800"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>

    <!-- Dark background inset từ trái 4dp -->
    <item android:left="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#F0101828"/>
            <corners
                android:topRightRadius="12dp"
                android:bottomRightRadius="12dp"/>
        </shape>
    </item>

    <!-- Viền mờ cam nhạt toàn bộ -->
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#44FF9800"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>

</layer-list>
