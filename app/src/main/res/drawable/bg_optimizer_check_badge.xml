<?xml version="1.0" encoding="utf-8"?>
<!-- Round glowing badge sitting behind the success check icon -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="46dp"
                android:startColor="#552CFF6E"
                android:endColor="#002CFF6E"/>
        </shape>
    </item>
    <item android:top="10dp" android:bottom="10dp" android:left="10dp" android:right="10dp">
        <shape android:shape="oval">
            <solid android:color="#1A2CFF6E"/>
            <stroke android:width="1.4dp" android:color="#802CFF6E"/>
        </shape>
    </item>
</layer-list>
