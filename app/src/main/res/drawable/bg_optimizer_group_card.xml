<?xml version="1.0" encoding="utf-8"?>
<!-- Optimizer group card — see-through black glass so the GIF background shows through -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#8A000000"/>
            <corners android:radius="18dp"/>
            <stroke android:width="1dp" android:color="#33FF5C72"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#18FF5C72"
                android:endColor="#00000000"
                android:type="linear"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
</layer-list>
