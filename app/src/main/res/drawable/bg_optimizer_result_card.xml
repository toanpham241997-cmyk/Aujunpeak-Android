<?xml version="1.0" encoding="utf-8"?>
<!-- Optimizer Super result card — dark glass with red/violet energy accent (matches app theme) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#E60D0B14"/>
            <corners android:radius="26dp"/>
            <stroke android:width="1.4dp" android:color="#66FF5C72"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#33FF5C72"
                android:centerColor="#1A8F00FF"
                android:endColor="#00000000"
                android:type="linear"/>
            <corners android:radius="26dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:type="radial"
                android:gradientRadius="180dp"
                android:centerX="0.22"
                android:centerY="0.08"
                android:startColor="#40FFFFFF"
                android:endColor="#00000000"/>
            <corners android:radius="26dp"/>
        </shape>
    </item>
</layer-list>
