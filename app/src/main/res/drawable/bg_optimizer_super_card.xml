<?xml version="1.0" encoding="utf-8"?>
<!-- OPTIMIZER SUPER entry card — dark frosted glass, see-through, red/violet energy -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#A60D0D14"/>
            <corners android:radius="20dp"/>
            <stroke android:width="1.2dp" android:color="#557E9CFF"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#2A7E9CFF"
                android:centerColor="#128F00FF"
                android:endColor="#00000000"
                android:type="linear"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:type="radial"
                android:gradientRadius="220dp"
                android:centerX="0.08"
                android:centerY="0.1"
                android:startColor="#3AFFFFFF"
                android:endColor="#00000000"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
</layer-list>
