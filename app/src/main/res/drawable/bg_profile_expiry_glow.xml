<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#22FF9800"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#1AFF9800"
                android:centerColor="#0D1A1000"
                android:endColor="#08CC7700"
                android:angle="135"/>
            <corners android:radius="12dp"/>
            <stroke
                android:width="1.5dp"
                android:color="#66FF9800"/>
        </shape>
    </item>
</layer-list>
