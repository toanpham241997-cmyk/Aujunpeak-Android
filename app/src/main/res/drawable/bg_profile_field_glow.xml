<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow layer -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#22FF1744"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
    <!-- Main background -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#1AFF1744"
                android:centerColor="#0D1A0A0A"
                android:endColor="#08CC0000"
                android:angle="135"
                android:type="linear"/>
            <corners android:radius="12dp"/>
            <stroke
                android:width="1.5dp"
                android:color="#66FF1744"/>
        </shape>
    </item>
</layer-list>
