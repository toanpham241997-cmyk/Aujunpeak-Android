<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#2269FF47"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#1A69FF47"
                android:centerColor="#0D0A1A0A"
                android:endColor="#0800CC44"
                android:angle="135"/>
            <corners android:radius="12dp"/>
            <stroke
                android:width="1.5dp"
                android:color="#6669FF47"/>
        </shape>
    </item>
</layer-list>
