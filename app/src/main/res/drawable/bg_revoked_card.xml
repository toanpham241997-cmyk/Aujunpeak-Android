<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#E61A0A14"/>
            <corners android:radius="24dp"/>
            <stroke android:width="1.5dp" android:color="#66FF5C72"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#33FF5C72"
                android:endColor="#00000000"
                android:type="linear"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:type="radial"
                android:gradientRadius="170dp"
                android:centerX="0.18"
                android:centerY="0.08"
                android:startColor="#22FFFFFF"
                android:endColor="#00000000"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>
</layer-list>
