<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#B31A1A1A"/>
            <corners android:radius="26dp"/>
            <stroke android:width="1.5dp" android:color="#337E9CFF"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="90dp"
                android:centerX="0.15"
                android:centerY="0.2"
                android:startColor="#26FFFFFF"
                android:endColor="#00000000"/>
            <corners android:radius="26dp"/>
        </shape>
    </item>
</layer-list>
