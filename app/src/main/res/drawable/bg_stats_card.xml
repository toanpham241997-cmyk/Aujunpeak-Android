<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#CC0E0E1C"/>
            <corners android:radius="20dp"/>
            <stroke android:width="1.5dp" android:color="#339C27B0"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#1A9C27B0"
                android:endColor="#00000000"
                android:type="linear"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:type="radial"
                android:gradientRadius="160dp"
                android:centerX="0.15"
                android:centerY="0.1"
                android:startColor="#25FFFFFF"
                android:endColor="#00000000"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
</layer-list>
