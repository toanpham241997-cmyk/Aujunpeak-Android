<?xml version="1.0" encoding="utf-8"?>
<!-- Compact rounded panel for the "feedback sent" success modal -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F00D1410"/>
            <corners android:radius="26dp"/>
            <stroke android:width="1.2dp" android:color="#4469FF47"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="220dp"
                android:centerX="0.5"
                android:centerY="0.05"
                android:startColor="#2669FF47"
                android:endColor="#00000000"/>
            <corners android:radius="26dp"/>
        </shape>
    </item>
</layer-list>
