<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#CC1A1A1A"/>
            <corners android:radius="20dp"/>
            <stroke android:width="1.5dp" android:color="#55FF5C72"/>
        </shape>
    </item>
    <item android:bottom="0dp" android:left="0dp" android:right="0dp" android:top="0dp">
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#22FF5C72"
                android:endColor="#00000000"
                android:type="linear"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
    <item android:bottom="0dp" android:left="0dp" android:right="0dp" android:top="0dp">
        <shape>
            <gradient
                android:type="radial"
                android:gradientRadius="150dp"
                android:centerX="0.18"
                android:centerY="0.1"
                android:startColor="#33FFFFFF"
                android:endColor="#00000000"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
</layer-list>
