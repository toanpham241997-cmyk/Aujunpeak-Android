<?xml version="1.0" encoding="utf-8"?>
<!-- Subtle glowing background for tagline text under author name -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="0"
        android:startColor="#227E9CFF"
        android:centerColor="#1500CFFF"
        android:endColor="#227E9CFF"
        android:type="linear"/>
    <corners android:radius="20dp"/>
    <stroke android:width="1dp" android:color="#2200CFFF"/>
</shape>
