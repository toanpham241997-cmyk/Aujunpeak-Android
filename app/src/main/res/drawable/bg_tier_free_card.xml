<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer glow layer -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#2264B5F6"
                android:centerColor="#1542A5F5"
                android:endColor="#0A1976D2"
                android:type="linear"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
    <!-- Main card -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#000F1F"
                android:centerColor="#001529"
                android:endColor="#000E1F"
                android:type="linear"/>
            <corners android:radius="20dp"/>
            <stroke android:width="1.5dp" android:color="#8864B5F6"/>
        </shape>
    </item>
</layer-list>
