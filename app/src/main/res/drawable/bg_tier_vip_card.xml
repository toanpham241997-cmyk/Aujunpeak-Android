<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer glow layer -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#33FFD700"
                android:centerColor="#22FFA500"
                android:endColor="#11FF8C00"
                android:type="linear"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
    <!-- Main card -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#1A1A00"
                android:centerColor="#2A1F00"
                android:endColor="#1F1500"
                android:type="linear"/>
            <corners android:radius="20dp"/>
            <stroke android:width="1.5dp" android:color="#CCFFD700"/>
        </shape>
    </item>
</layer-list>
