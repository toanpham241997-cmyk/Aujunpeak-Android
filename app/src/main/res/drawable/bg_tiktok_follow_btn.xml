<?xml version="1.0" encoding="utf-8"?>
<!-- TikTok-themed follow button: dark glass + cyan border -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#33010D0F"
                android:endColor="#33010D0F"
                android:type="linear"/>
            <corners android:radius="22dp"/>
            <stroke android:width="1.5dp" android:color="#88FF1744"/>
        </shape>
    </item>
</layer-list>
