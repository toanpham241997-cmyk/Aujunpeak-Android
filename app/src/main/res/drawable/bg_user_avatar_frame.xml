<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer glow ring -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#33FF5C72"/>
            <stroke android:width="2dp" android:color="#88FF5C72"/>
        </shape>
    </item>
    <!-- Inner translucent glass background -->
    <item android:top="4dp" android:left="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#CC2A0A0A"
                android:endColor="#CC1A1A1A"
                android:angle="135"/>
            <stroke android:width="1.5dp" android:color="#44FF5C72"/>
        </shape>
    </item>
</layer-list>
