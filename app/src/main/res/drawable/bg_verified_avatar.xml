<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Vòng ngoài xanh mờ (glow) -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#2869FF47"/>
            <stroke android:width="2.5dp" android:color="#9969FF47"/>
        </shape>
    </item>
    <!-- Vòng trong tối -->
    <item
        android:top="5dp"
        android:left="5dp"
        android:right="5dp"
        android:bottom="5dp">
        <shape android:shape="oval">
            <solid android:color="#1C1C1C"/>
            <stroke android:width="2dp" android:color="#69FF47"/>
        </shape>
    </item>
</layer-list>
