<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="0"
                android:startColor="#7E9CFF"
                android:endColor="#B71C1C"
                android:type="linear"/>
            <corners android:radius="25dp"/>
        </shape>
    </item>
    <item android:top="0dp" android:left="0dp" android:right="0dp" android:bottom="0dp">
        <shape>
            <gradient
                android:type="radial"
                android:gradientRadius="120dp"
                android:centerX="0.3"
                android:centerY="0.3"
                android:startColor="#33FFFFFF"
                android:endColor="#00000000"/>
            <corners android:radius="25dp"/>
        </shape>
    </item>
</layer-list>
