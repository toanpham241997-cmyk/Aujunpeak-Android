<?xml version="1.0" encoding="utf-8"?>
<!-- ForceUpdate — nút Sao chép link: border glass -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#22FFFFFF"/>
            <corners android:radius="50dp"/>
            <stroke android:width="1.5dp" android:color="#80FFFFFF"/>
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#12FFFFFF"/>
                    <corners android:radius="50dp"/>
                    <stroke android:width="1.5dp" android:color="#45FFFFFF"/>
                </shape>
            </item>
            <!-- Top sheen subtle -->
            <item android:left="8dp" android:top="3dp" android:right="8dp" android:bottom="22dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="90"
                        android:startColor="#20FFFFFF"
                        android:endColor="#00FFFFFF"
                        android:type="linear"/>
                    <corners android:radius="44dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
