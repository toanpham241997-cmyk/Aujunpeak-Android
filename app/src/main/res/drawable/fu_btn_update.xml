<?xml version="1.0" encoding="utf-8"?>
<!-- ForceUpdate — nút Cập nhật ngay: gradient cam, pill, viền sáng -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="135"
                        android:startColor="#8A2E00"
                        android:centerColor="#D44000"
                        android:endColor="#FF5200"
                        android:type="linear"/>
                    <corners android:radius="50dp"/>
                    <stroke android:width="1.5dp" android:color="#88FF9040"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <!-- Normal state -->
    <item>
        <layer-list>
            <!-- Glow layer (outer) -->
            <item android:left="-4dp" android:top="-4dp" android:right="-4dp" android:bottom="-4dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:type="radial"
                        android:gradientRadius="120dp"
                        android:startColor="#30FF6D00"
                        android:endColor="#00000000"/>
                    <corners android:radius="54dp"/>
                </shape>
            </item>
            <!-- Main gradient body -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="135"
                        android:startColor="#FF4500"
                        android:centerColor="#FF6D00"
                        android:endColor="#FF8C00"
                        android:type="linear"/>
                    <corners android:radius="50dp"/>
                    <stroke android:width="1.5dp" android:color="#88FFAB40"/>
                </shape>
            </item>
            <!-- Top sheen -->
            <item
                android:left="10dp"
                android:top="4dp"
                android:right="10dp"
                android:bottom="24dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="90"
                        android:startColor="#50FFFFFF"
                        android:endColor="#00FFFFFF"
                        android:type="linear"/>
                    <corners android:radius="44dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
