<?xml version="1.0" encoding="utf-8"?>
<!-- ForceUpdate — khung card chính: glassmorphism tối, viền cam mờ -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Nền gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="150"
                android:startColor="#E6080F1E"
                android:centerColor="#E60B1428"
                android:endColor="#E6060C1A"
                android:type="linear"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
    <!-- Viền cam mờ -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000"/>
            <stroke android:width="1dp" android:color="#55FF6D00"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
    <!-- Ánh sáng trên cùng bên trái -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="160dp"
                android:centerX="0.15"
                android:centerY="0.05"
                android:startColor="#28FF6D00"
                android:endColor="#00000000"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
</layer-list>
