<?xml version='1.0' encoding='UTF-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_neo_screen">

    <ImageView android:id="@+id/optimizerBgGif" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:alpha="0.12" android:contentDescription="@null"/>
    <View android:layout_width="300dp" android:layout_height="300dp" android:layout_gravity="top|end" android:layout_marginTop="-120dp" android:layout_marginEnd="-120dp" android:background="@drawable/bg_neo_glow_violet" android:alpha="0.48"/>
    <View android:layout_width="260dp" android:layout_height="260dp" android:layout_gravity="bottom|start" android:layout_marginStart="-100dp" android:layout_marginBottom="-100dp" android:background="@drawable/bg_neo_glow_cyan" android:alpha="0.38"/>
    <com.aujunpeak.app.views.BoostParticleView android:id="@+id/optimizerParticles" android:layout_width="match_parent" android:layout_height="match_parent" android:alpha="0.36"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="68dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="18dp" android:paddingEnd="18dp">
            <LinearLayout android:id="@+id/btnOptBack" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_neo_icon_plate" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="horizontal" android:foreground="?attr/selectableItemBackground"><ImageView android:layout_width="19dp" android:layout_height="19dp" android:src="@drawable/ic_arrow_back" android:tint="@color/neo_cyan"/></LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/optimizer_title" android:textColor="@color/white" android:textSize="17sp" android:textStyle="bold" android:includeFontPadding="false"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="DEVICE CLEANUP MODULES" android:textColor="@color/neo_text_muted" android:textSize="11sp" android:letterSpacing="0.035" android:includeFontPadding="false"/>
            </LinearLayout>
            <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_neo_icon_plate"><ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/ic_speed_neo" android:tint="@color/neo_violet"/></FrameLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="18dp" android:layout_marginEnd="18dp" android:layout_marginBottom="12dp" android:background="@drawable/bg_neo_hero" android:orientation="horizontal" android:gravity="center_vertical" android:padding="15dp">
            <FrameLayout android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_neo_icon_plate"><ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/ic_layers_neo" android:tint="@color/neo_cyan"/></FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SMART OPTIMIZER" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" android:includeFontPadding="false"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Choose only the modules you want to apply" android:textColor="@color/neo_text_muted" android:textSize="11.5sp" android:includeFontPadding="false"/>
            </LinearLayout>
        </LinearLayout>

        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingStart="16dp" android:paddingEnd="16dp" android:scrollbars="none">
            <LinearLayout android:id="@+id/containerOptimizerGroups" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="30dp"/>
        </ScrollView>

        <LinearLayout android:layout_width="match_parent" android:layout_height="84dp" android:background="@drawable/bg_neo_bottom_nav" android:elevation="12dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp">
            <LinearLayout android:id="@+id/btnSelectAll" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:layout_marginEnd="10dp" android:background="@drawable/bg_neo_button_secondary" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="horizontal" android:foreground="?attr/selectableItemBackground"><TextView android:id="@+id/tvSelectAll" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/optimizer_select_all" android:textColor="@color/neo_cyan" android:textSize="14sp" android:textStyle="bold" android:includeFontPadding="false"/></LinearLayout>
            <LinearLayout android:id="@+id/btnOptApply" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1.25" android:background="@drawable/bg_neo_button_primary" android:clickable="true" android:elevation="8dp" android:focusable="true" android:gravity="center" android:orientation="horizontal" android:foreground="?attr/selectableItemBackground"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/optimizer_apply" android:textColor="@color/white" android:textSize="15sp" android:textStyle="bold" android:includeFontPadding="false"/></LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout android:id="@+id/optProgressOverlay" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#D9060914" android:clickable="true" android:elevation="30dp" android:focusable="true" android:visibility="gone" android:foreground="?attr/selectableItemBackground">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_marginStart="26dp" android:layout_marginEnd="26dp" android:background="@drawable/bg_neo_modal" android:gravity="center" android:orientation="vertical" android:padding="24dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="OPTIMIZING" android:textColor="@color/neo_cyan" android:textSize="11.5sp" android:textStyle="bold" android:letterSpacing="0.035" android:includeFontPadding="false"/>
            <com.aujunpeak.app.views.RingLoaderView android:id="@+id/optBoostRing" android:layout_width="120dp" android:layout_height="120dp" android:layout_marginTop="8dp"/>
            <ProgressBar android:id="@+id/optProgressBar" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="15dp" android:max="100" android:progress="0" android:progressDrawable="@drawable/bg_boost_progress"/>
            <TextView android:id="@+id/tvOptPercent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="0%" android:textColor="@color/neo_cyan" android:textSize="26sp" android:textStyle="bold" android:includeFontPadding="false"/>
            <TextView android:id="@+id/tvOptStep" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center" android:text="@string/optimizer_processing" android:textColor="@color/neo_text_muted" android:textSize="13sp" android:includeFontPadding="false"/>
        </LinearLayout>
    </FrameLayout>

    <FrameLayout android:id="@+id/optResultOverlay" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#E7060914" android:clickable="true" android:elevation="32dp" android:focusable="true" android:visibility="gone" android:foreground="?attr/selectableItemBackground">
        <LinearLayout android:id="@+id/resultCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_marginStart="26dp" android:layout_marginEnd="26dp" android:background="@drawable/bg_neo_modal" android:gravity="center" android:orientation="vertical" android:padding="24dp">
            <FrameLayout android:layout_width="84dp" android:layout_height="84dp" android:background="@drawable/bg_neo_status_green"><ImageView android:id="@+id/ivOptResultCheck" android:layout_width="46dp" android:layout_height="46dp" android:layout_gravity="center" android:src="@drawable/ic_check_green"/></FrameLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/optimizer_success" android:textColor="@color/white" android:textSize="18sp" android:textStyle="bold" android:includeFontPadding="false"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="@string/optimizer_done_title" android:textColor="@color/neo_green" android:textSize="12sp" android:textStyle="bold" android:includeFontPadding="false"/>
            <TextView android:id="@+id/tvOptResultSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:text="" android:textColor="@color/neo_text_muted" android:textSize="13sp" android:includeFontPadding="false"/>
            <LinearLayout android:id="@+id/btnOptOpenFF" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="18dp" android:background="@drawable/bg_neo_button_primary" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="horizontal" android:foreground="?attr/selectableItemBackground"><ImageView android:layout_width="21dp" android:layout_height="21dp" android:src="@drawable/ic_nav_game_neo" android:tint="@color/white"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/optimizer_open_ff" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" android:includeFontPadding="false"/></LinearLayout>
            <LinearLayout android:id="@+id/btnOptDone" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="9dp" android:background="@drawable/bg_neo_button_secondary" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="horizontal" android:foreground="?attr/selectableItemBackground"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/optimizer_restart" android:textColor="@color/neo_cyan" android:textSize="14sp" android:textStyle="bold" android:includeFontPadding="false"/></LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
