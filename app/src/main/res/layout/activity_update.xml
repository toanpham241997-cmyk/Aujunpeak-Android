<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050D1A">

    <!-- ══ GIF BACKGROUND — same GIF used in MainActivity ══ -->
    <ImageView
        android:id="@+id/updateBgGif"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null"/>

    <!-- Dark overlay so content is readable -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_gif_overlay"/>

    <!-- Particle effect layer -->
    <com.aujunpeak.app.views.ParticleView
        android:id="@+id/updateParticles"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- Watermark "UPDATE" text -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="@string/update_title"
        android:textSize="72sp"
        android:textStyle="bold"
        android:textColor="#0D1E88FF"
        android:gravity="center"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.2"
        android:rotation="-20"/>

    <!-- Back button -->
    <LinearLayout
        android:id="@+id/btnUpdateBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_arrow_back"
            android:layout_marginRight="6dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/update_back_btn"
            android:textColor="#AAFFFFFF"
            android:textSize="14sp"/>
    </LinearLayout>

    <!-- Main content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="64dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal">

            <!-- ══ ANIMATED HEADER TITLE ══ -->
            <LinearLayout
                android:id="@+id/layoutUpdateHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/tvUpdateTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/update_new_version"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.15"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvUpdateSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/update_subtitle"
                    android:textSize="12sp"
                    android:textColor="#88FFFFFF"
                    android:gravity="center"/>
            </LinearLayout>

            <!-- ══ APP VERSION CARD (existing id kept) ══ -->
            <FrameLayout
                android:id="@+id/updateCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_update_card"
                android:padding="24dp"
                android:layout_marginBottom="16dp">

                <!-- Animated green status dot top-right -->
                <View
                    android:id="@+id/vUpdateDot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="top|right"
                    android:layout_margin="16dp"
                    android:background="@drawable/ic_status_dot_green"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <!-- App icon ring with glow -->
                    <FrameLayout
                        android:layout_width="110dp"
                        android:layout_height="110dp"
                        android:layout_marginBottom="16dp">
                        <View android:layout_width="110dp" android:layout_height="110dp"
                            android:layout_gravity="center" android:background="@drawable/bg_glow_circle"/>
                        <com.aujunpeak.app.views.RingLoaderView
                            android:id="@+id/updateRingLoader"
                            android:layout_width="90dp" android:layout_height="90dp"
                            android:layout_gravity="center"/>
                        <View android:layout_width="74dp" android:layout_height="74dp"
                            android:layout_gravity="center" android:background="@drawable/ring_dashed_cyan"/>
                        <ImageView android:layout_width="54dp" android:layout_height="54dp"
                            android:layout_gravity="center" android:src="@drawable/ic_update_arrow"/>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvVersionBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="v1.0.4"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/green_success"
                        android:fontFamily="sans-serif-black"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/update_version_name"
                        android:textSize="14sp"
                        android:textColor="#DDFFFFFF"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="16dp"/>

                    <!-- Status row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_stat_chip"
                        android:padding="12dp"
                        android:gravity="center">
                        <View android:layout_width="8dp" android:layout_height="8dp"
                            android:background="@drawable/ic_status_dot_green" android:layout_marginRight="8dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/update_latest_msg"
                            android:textColor="@color/green_success" android:textSize="12sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- ══ DYNAMIC UI / DATA UPDATE ══ -->
            <FrameLayout
                android:id="@+id/cardDynamicUi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_neo_card_cyan"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_neo_icon_plate">
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_update_arrow" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="DATA UI"
                                android:textColor="@android:color/white"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tvDynamicUiVersion"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="Data version: local"
                                android:textColor="@color/neo_text_3"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDynamicUiStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Giao diện có thể cập nhật bằng JSON/ảnh/GIF mà không cần tải lại APK."
                        android:textColor="@color/neo_text_2"
                        android:textSize="10.5sp" />

                    <FrameLayout
                        android:id="@+id/btnDynamicUiRefresh"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_neo_button_primary"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView
                            android:id="@+id/tvDynamicUiRefresh"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="KIỂM TRA DATA MỚI"
                            android:textColor="@android:color/white"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </FrameLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- ══ WHAT'S NEW CARD — ANIMATED TEXT ══ -->
            <FrameLayout
                android:id="@+id/cardWhatsNew"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_free_fire_card"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Section title -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <FrameLayout android:layout_width="36dp" android:layout_height="36dp"
                            android:layout_marginRight="12dp"
                            android:background="@drawable/bg_ff_switch_icon_card">
                            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                                android:layout_gravity="center" android:src="@drawable/ic_update_arrow"/>
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvWhatsNewTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/update_whats_new"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:fontFamily="sans-serif-black"
                            android:letterSpacing="0.1"/>
                    </LinearLayout>

                    <!-- Feature items with icons -->
                    <LinearLayout android:id="@+id/featureItem1"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">
                        <FrameLayout android:layout_width="28dp" android:layout_height="28dp"
                            android:background="@drawable/bg_feature_row_boost" android:layout_marginRight="12dp">
                            <ImageView android:layout_width="16dp" android:layout_height="16dp"
                                android:layout_gravity="center" android:src="@drawable/ic_feature_lightning"/>
                        </FrameLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/update_change1_title"
                                android:textColor="@color/white" android:textSize="13sp"
                                android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/update_change1_sub"
                                android:textColor="@color/gray_text" android:textSize="11sp"/>
                        </LinearLayout>
                        <View android:id="@+id/dotFeature1" android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_active_dot_green"/>
                    </LinearLayout>

                    <LinearLayout android:id="@+id/featureItem2"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">
                        <FrameLayout android:layout_width="28dp" android:layout_height="28dp"
                            android:background="@drawable/bg_feature_row_game" android:layout_marginRight="12dp">
                            <ImageView android:layout_width="16dp" android:layout_height="16dp"
                                android:layout_gravity="center" android:src="@drawable/ic_perf_cpu"/>
                        </FrameLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/update_change2_title"
                                android:textColor="@color/white" android:textSize="13sp"
                                android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/update_change2_sub"
                                android:textColor="@color/gray_text" android:textSize="11sp"/>
                        </LinearLayout>
                        <View android:id="@+id/dotFeature2" android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_active_dot_green"/>
                    </LinearLayout>

                    <LinearLayout android:id="@+id/featureItem3"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">
                        <FrameLayout android:layout_width="28dp" android:layout_height="28dp"
                            android:background="@drawable/bg_feature_row_power" android:layout_marginRight="12dp">
                            <ImageView android:layout_width="16dp" android:layout_height="16dp"
                                android:layout_gravity="center" android:src="@drawable/ic_crosshair_target"/>
                        </FrameLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/update_change3_title"
                                android:textColor="@color/white" android:textSize="13sp"
                                android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/update_change3_sub"
                                android:textColor="@color/gray_text" android:textSize="11sp"/>
                        </LinearLayout>
                        <View android:id="@+id/dotFeature3" android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_active_dot_green"/>
                    </LinearLayout>

                    <LinearLayout android:id="@+id/featureItem4"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <FrameLayout android:layout_width="28dp" android:layout_height="28dp"
                            android:background="@drawable/bg_feature_row_boost" android:layout_marginRight="12dp">
                            <ImageView android:layout_width="16dp" android:layout_height="16dp"
                                android:layout_gravity="center" android:src="@drawable/ic_network_boost"/>
                        </FrameLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/update_change4_title"
                                android:textColor="@color/white" android:textSize="13sp"
                                android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/update_change4_sub"
                                android:textColor="@color/gray_text" android:textSize="11sp"/>
                        </LinearLayout>
                        <View android:id="@+id/dotFeature4" android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_active_dot_green"/>
                    </LinearLayout>

                </LinearLayout>
            </FrameLayout>

            <!-- ══ STATS CARD — FROSTED GLASS ══ -->
            <FrameLayout
                android:id="@+id/cardUpdateStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp">

                <View android:layout_width="match_parent" android:layout_height="match_parent"
                    android:background="@drawable/bg_frosted_card_cyan"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvStatsTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/update_perf_stats"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.12"
                        android:layout_marginBottom="16dp"/>

                    <!-- Stats row -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:gravity="center"
                            android:background="@drawable/bg_stat_chip" android:padding="12dp"
                            android:layout_marginRight="8dp">
                            <TextView android:id="@+id/tvStatRam"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="↑ 45%" android:textSize="18sp" android:textStyle="bold"
                                android:textColor="@color/red_bright" android:fontFamily="sans-serif-black"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/update_stat_ram" android:textSize="10sp"
                                android:textColor="@color/gray_text" android:layout_marginTop="2dp"/>
                        </LinearLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:gravity="center"
                            android:background="@drawable/bg_stat_chip" android:padding="12dp"
                            android:layout_marginRight="8dp">
                            <TextView android:id="@+id/tvStatFps"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="+22fps" android:textSize="18sp" android:textStyle="bold"
                                android:textColor="#00CFFF" android:fontFamily="sans-serif-black"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/update_stat_fps" android:textSize="10sp"
                                android:textColor="@color/gray_text" android:layout_marginTop="2dp"/>
                        </LinearLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:gravity="center"
                            android:background="@drawable/bg_stat_chip" android:padding="12dp">
                            <TextView android:id="@+id/tvStatPing"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="-30ms" android:textSize="18sp" android:textStyle="bold"
                                android:textColor="@color/green_success" android:fontFamily="sans-serif-black"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/update_stat_ping" android:textSize="10sp"
                                android:textColor="@color/gray_text" android:layout_marginTop="2dp"/>
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- ══ COMING SOON CARD ══ -->
            <FrameLayout
                android:id="@+id/cardComingSoon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <View android:layout_width="match_parent" android:layout_height="match_parent"
                    android:background="@drawable/bg_frosted_settings"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvComingSoonTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/update_coming_soon"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#884DFF"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.12"
                        android:layout_marginBottom="14dp"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">
                        <View android:layout_width="4dp" android:layout_height="4dp"
                            android:background="@drawable/bg_active_dot_green" android:layout_marginRight="10dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/update_future1"
                            android:textColor="#CCFFFFFF" android:textSize="12sp"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">
                        <View android:layout_width="4dp" android:layout_height="4dp"
                            android:background="@drawable/bg_active_dot_green" android:layout_marginRight="10dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/update_future2"
                            android:textColor="#CCFFFFFF" android:textSize="12sp"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <View android:layout_width="4dp" android:layout_height="4dp"
                            android:background="@drawable/bg_active_dot_green" android:layout_marginRight="10dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/update_future3"
                            android:textColor="#CCFFFFFF" android:textSize="12sp"/>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- Footer -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/update_footer"
                android:textColor="#33FFFFFF"
                android:textSize="10sp"
                android:gravity="center"
                android:layout_marginBottom="16dp"/>

        </LinearLayout>
    </ScrollView>

</FrameLayout>
