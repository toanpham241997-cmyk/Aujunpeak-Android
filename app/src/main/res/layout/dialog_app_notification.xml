<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#C9000000" />

    <com.aujunpeak.app.views.ParticleView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.16" />

    <LinearLayout
        android:id="@+id/notifCard"
        android:layout_width="328dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/bg_notification_card"
        android:padding="26dp"
        android:elevation="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LIVE NOTICE"
            android:textColor="#FFB74D"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.18"
            android:background="@drawable/bg_badge_orange"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp" />

        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="14dp">

            <View
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:background="@drawable/glow_circle_orange_outer"
                android:alpha="0.58" />

            <FrameLayout
                android:id="@+id/notifIconBell"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_bell_icon_circle">

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_notifications"
                    android:tint="#FFFFFF" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/tvNotifTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/notif_dialog_subject"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Aujunpeak notification center"
            android:textColor="#88FFFFFF"
            android:textSize="10sp" />

        <View
            android:layout_width="64dp"
            android:layout_height="2dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:background="#66FF9800" />

        <TextView
            android:id="@+id/tvNotifBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/notif_dialog_content"
            android:textColor="#EEEEEE"
            android:textSize="14sp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.35"
            android:layout_marginBottom="22dp" />

        <FrameLayout
            android:id="@+id/btnNotifOk"
            android:layout_width="210dp"
            android:layout_height="50dp"
            android:background="@drawable/btn_notification_ok"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/notif_dialog_read_btn"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
