<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="false" android:clipToPadding="false" android:overScrollMode="never" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="8dp" android:paddingBottom="18dp">

            <FrameLayout android:id="@+id/cardCrosshair" android:layout_width="match_parent" android:layout_height="132dp" android:background="@drawable/bg_neo_hero" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackgroundBorderless">
                <com.aujunpeak.app.views.BoostParticleView android:id="@+id/crosshairParticles" android:layout_width="match_parent" android:layout_height="match_parent" android:alpha="0.25"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
                    <FrameLayout android:layout_width="66dp" android:layout_height="66dp" android:background="@drawable/bg_neo_icon_plate"><ImageView android:layout_width="38dp" android:layout_height="38dp" android:layout_gravity="center" android:src="@drawable/ic_crosshair" android:tint="@color/neo_cyan"/></FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/func_crosshair_label" android:textColor="@color/neo_cyan" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.14"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="@string/func_crosshair_title" android:textColor="@color/neo_text" android:textSize="18sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/func_crosshair_desc" android:textColor="@color/neo_text_2" android:textSize="10sp"/></LinearLayout>
                    <FrameLayout android:layout_width="38dp" android:layout_height="38dp" android:background="@drawable/bg_neo_chip_active"><ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:src="@drawable/ic_chevron_right" android:tint="@color/neo_cyan" /></FrameLayout>
                </LinearLayout>
            </FrameLayout>

            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_neo_card">
                <com.aujunpeak.app.views.ParticleView android:id="@+id/particlesPerformance" android:layout_width="1dp" android:layout_height="1dp" android:alpha="0"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp"><LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="4dp" android:paddingEnd="4dp"><ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_speed_neo"/><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="9dp" android:text="@string/func_performance" android:textColor="@color/neo_text" android:textSize="13sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LIVE TUNING" android:textColor="@color/neo_violet" android:textSize="9sp" android:textStyle="bold" android:background="@drawable/bg_neo_chip"/></LinearLayout><include android:id="@+id/switchHighPerf" layout="@layout/item_switch_icon_row"/><Space android:layout_width="1dp" android:layout_height="7dp"/><include android:id="@+id/switchGpuTurbo" layout="@layout/item_switch_icon_row"/><Space android:layout_width="1dp" android:layout_height="7dp"/><include android:id="@+id/switchNetBoost" layout="@layout/item_switch_icon_row"/></LinearLayout>
            </FrameLayout>

            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_neo_card_violet">
                <com.aujunpeak.app.views.ParticleView android:id="@+id/particlesFreeFireFunc" android:layout_width="1dp" android:layout_height="1dp" android:alpha="0"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal"><androidx.cardview.widget.CardView android:layout_width="46dp" android:layout_height="46dp" app:cardBackgroundColor="#182237" app:cardCornerRadius="8dp" app:cardElevation="0dp"><ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:padding="4dp" android:scaleType="centerCrop" android:src="@drawable/ff_app_logo"/></androidx.cardview.widget.CardView><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="11dp" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FREE FIRE PROFILE" android:textColor="@color/neo_text" android:textSize="16sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/func_ff_subtitle" android:textColor="@color/neo_text_3" android:textSize="10sp"/></LinearLayout><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PRESET" android:textColor="@color/neo_violet" android:textSize="9sp" android:textStyle="bold" android:background="@drawable/bg_neo_chip"/></LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="72dp" android:layout_marginTop="12dp" android:gravity="center_vertical" android:orientation="horizontal" android:background="@drawable/bg_neo_card" android:paddingStart="10dp" android:paddingEnd="8dp">
                        <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_neo_icon_plate"><View android:id="@+id/vFFGraphicsRing" android:layout_width="42dp" android:layout_height="42dp" android:layout_gravity="center" android:background="@drawable/bg_orbital_ring" android:alpha="0.45"/><ImageView android:id="@+id/ivFFGraphicsIcon" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/ic_ff_graphics"/></FrameLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/func_ultra_graphics" android:textColor="@color/neo_text" android:textSize="12sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/func_ultra_graphics_desc" android:textColor="@color/neo_text_3" android:textSize="9sp"/></LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchFFGraphics" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="72dp" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal" android:background="@drawable/bg_neo_card" android:paddingStart="10dp" android:paddingEnd="8dp">
                        <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_neo_icon_plate"><View android:id="@+id/vFFAntiLagRing" android:layout_width="42dp" android:layout_height="42dp" android:layout_gravity="center" android:background="@drawable/bg_orbital_ring" android:alpha="0.45"/><ImageView android:id="@+id/ivFFAntiLagIcon" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/ic_ff_antilag"/></FrameLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/func_delay_pigs" android:textColor="@color/neo_text" android:textSize="12sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/func_delay_pigs_desc" android:textColor="@color/neo_text_3" android:textSize="9sp"/></LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchFFAntiLag" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <include android:id="@+id/switchAimlockPro" layout="@layout/item_switch_icon_row" />
                    <Space android:layout_width="1dp" android:layout_height="7dp"/>
                    <include android:id="@+id/switchEspAimlock" layout="@layout/item_switch_icon_row" />
                    <Space android:layout_width="1dp" android:layout_height="7dp"/>
                    <include android:id="@+id/switchAimlockBox" layout="@layout/item_switch_icon_row" />

                    <FrameLayout android:layout_width="match_parent" android:layout_height="66dp" android:layout_marginTop="10dp">
                        <com.aujunpeak.app.views.ParticleView android:id="@+id/applyBtnParticles" android:layout_width="match_parent" android:layout_height="match_parent" android:alpha="0.25"/>
                        <LinearLayout android:id="@+id/btnApplyFF" android:layout_width="match_parent" android:layout_height="58dp" android:layout_gravity="center" android:gravity="center" android:orientation="horizontal" android:background="@drawable/bg_neo_button_primary" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackgroundBorderless">
                            <FrameLayout android:layout_width="42dp" android:layout_height="42dp"><View android:id="@+id/vRocketOrbitOuter" android:layout_width="42dp" android:layout_height="42dp" android:background="@drawable/bg_orbital_ring"/><View android:id="@+id/vRocketOrbitInner" android:layout_width="30dp" android:layout_height="30dp" android:layout_gravity="center" android:background="@drawable/bg_orbital_ring"/><View android:id="@+id/vOrbitalDot" android:layout_width="7dp" android:layout_height="7dp" android:layout_gravity="top|center_horizontal" android:background="@drawable/bg_active_dot_green"/><ImageView android:id="@+id/ivRocketApply" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/ic_speed_neo" android:tint="#07101B"/></FrameLayout><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="9dp" android:text="@string/func_apply_game" android:textColor="#07101B" android:textSize="14sp" android:textStyle="bold" android:letterSpacing="0.10"/>
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>
            </FrameLayout>

            <FrameLayout android:id="@+id/cardOptimizerSuper" android:layout_width="match_parent" android:layout_height="116dp" android:layout_marginTop="10dp" android:background="@drawable/bg_neo_card_gold" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackgroundBorderless">
                <com.aujunpeak.app.views.ParticleView android:id="@+id/particlesOptimizerSuper" android:layout_width="match_parent" android:layout_height="match_parent" android:alpha="0.18"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:padding="14dp"><FrameLayout android:layout_width="66dp" android:layout_height="66dp"><View android:id="@+id/vOptOrbitOuter" android:layout_width="66dp" android:layout_height="66dp" android:background="@drawable/bg_orbital_ring"/><View android:id="@+id/vOptOrbitInner" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center" android:background="@drawable/bg_orbital_ring"/><View android:id="@+id/vOptOrbitDot" android:layout_width="8dp" android:layout_height="8dp" android:layout_gravity="top|center_horizontal" android:background="@drawable/bg_active_dot_green"/><ImageView android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center" android:src="@drawable/ic_layers_neo"/></FrameLayout><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/optimizer_title" android:textColor="@color/neo_gold" android:textSize="15sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/func_optimizer_desc" android:textColor="@color/neo_text_2" android:textSize="10sp"/></LinearLayout><FrameLayout android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/bg_neo_chip"><ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:src="@drawable/ic_chevron_right" android:tint="@color/neo_gold" /></FrameLayout></LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout android:id="@+id/funcSwitchModal" android:layout_width="match_parent" android:layout_height="86dp" android:layout_gravity="top" android:layout_margin="14dp" android:background="@drawable/bg_neo_modal" android:elevation="20dp" android:visibility="gone"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="13dp" android:paddingEnd="13dp"><FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_neo_icon_plate"><ImageView android:id="@+id/ivFuncModalIcon" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center"/></FrameLayout><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical"><TextView android:id="@+id/tvFuncModalTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/neo_text" android:textSize="13sp" android:textStyle="bold"/><TextView android:id="@+id/tvFuncModalState" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="@color/neo_cyan" android:textSize="10sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Module sync completed" android:textColor="@color/neo_text_3" android:textSize="9sp"/></LinearLayout><ImageView android:id="@+id/ivFuncModalStatus" android:layout_width="22dp" android:layout_height="22dp"/></LinearLayout><View android:id="@+id/vFuncProgressFill" android:layout_width="0dp" android:layout_height="3dp" android:layout_gravity="bottom|start" android:background="@drawable/bg_neo_divider"/></FrameLayout>
</FrameLayout>
