<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_neo_screen">

    <View android:layout_width="260dp" android:layout_height="260dp" android:layout_gravity="top|end" android:layout_marginTop="-70dp" android:layout_marginEnd="-90dp" android:background="@drawable/bg_neo_glow_violet" android:alpha="0.55"/>
    <View android:layout_width="230dp" android:layout_height="230dp" android:layout_gravity="bottom|start" android:layout_marginBottom="-80dp" android:layout_marginStart="-80dp" android:background="@drawable/bg_neo_glow_cyan" android:alpha="0.45"/>
    <com.aujunpeak.app.views.RainView android:id="@+id/rainView" android:layout_width="match_parent" android:layout_height="match_parent" android:alpha="0.11"/>

    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="false" android:clipToPadding="false" android:overScrollMode="never" android:scrollbars="none">
        <LinearLayout
            android:id="@+id/loginContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="18dp"
            android:paddingBottom="26dp">

            <TextView
                android:id="@+id/tvBackBtn"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="14dp"
                android:text="←  Back"
                android:textColor="@color/neo_text_2"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_neo_button_secondary"
                android:clickable="true"
                android:focusable="true" />

            <FrameLayout
                android:id="@+id/cardLoginHeader"
                android:layout_width="match_parent"
                android:layout_height="204dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_neo_hero">

                <com.aujunpeak.app.views.ParticleView android:id="@+id/loginHeaderParticles" android:layout_width="match_parent" android:layout_height="match_parent" android:alpha="0.32"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="16dp">
                    <FrameLayout android:id="@+id/iconCircleFrame" android:layout_width="112dp" android:layout_height="112dp">
                        <View android:id="@+id/iconGlowOuter" android:layout_width="112dp" android:layout_height="112dp" android:background="@drawable/bg_key_circle" android:alpha="0.75"/>
                        <FrameLayout android:layout_width="82dp" android:layout_height="82dp" android:layout_gravity="center" android:background="@drawable/bg_key_inner_circle">
                            <com.airbnb.lottie.LottieAnimationView android:id="@+id/ivKeyIcon" android:layout_width="76dp" android:layout_height="76dp" android:layout_gravity="center" app:lottie_rawRes="@raw/ic_key_lock" app:lottie_autoPlay="true" app:lottie_loop="true" />
                            <com.airbnb.lottie.LottieAnimationView android:id="@+id/ivRobotIcon" android:layout_width="76dp" android:layout_height="76dp" android:layout_gravity="center" android:visibility="gone" app:lottie_rawRes="@raw/ic_robot_check" app:lottie_autoPlay="true" app:lottie_loop="true" />
                        </FrameLayout>
                        <com.aujunpeak.app.views.RingLoaderView android:id="@+id/ringLoaderLogin" android:layout_width="112dp" android:layout_height="112dp" android:layout_gravity="center" android:visibility="gone"/>
                    </FrameLayout>
                    <TextView android:id="@+id/tvLoginStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:text="@string/login_hint_text" android:textColor="@color/neo_text" android:textSize="14sp" android:textStyle="bold" android:lineSpacingExtra="2dp"/>
                    <LinearLayout android:id="@+id/tvKeyBadge" android:layout_width="wrap_content" android:layout_height="30dp" android:layout_marginTop="8dp" android:gravity="center" android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="12dp" android:background="@drawable/bg_neo_status_red">
                        <View android:layout_width="7dp" android:layout_height="7dp" android:background="@drawable/bg_red_dot"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:text="@string/login_not_activated" android:textColor="@color/neo_red" android:textSize="10sp" android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardKeyInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">
                <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_neo_card_cyan">
                    <com.aujunpeak.app.views.ParticleView android:id="@+id/loginCardParticles" android:layout_width="1dp" android:layout_height="1dp" android:alpha="0.2"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="KEY ACCESS" android:textColor="@color/neo_cyan" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.14"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Activate your key" android:textColor="@color/neo_text" android:textSize="20sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/login_key_format" android:textColor="@color/neo_text_3" android:textSize="10sp"/>
                        <LinearLayout android:id="@+id/inputFrame" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="14dp" android:gravity="center_vertical" android:orientation="horizontal" android:background="@drawable/bg_neo_input">
                            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_key_neo"/>
                            <EditText android:id="@+id/etKeyInput" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="10dp" android:background="@android:color/transparent" android:hint="@string/login_input_hint" android:singleLine="true" android:textColor="@color/neo_text" android:textColorHint="@color/neo_text_3" android:textSize="13sp" android:textStyle="bold" android:inputType="textCapCharacters"/>
                        </LinearLayout>
                        <FrameLayout android:id="@+id/btnLogin" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:background="@drawable/bg_neo_button_primary" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackgroundBorderless">
                            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center_vertical" android:orientation="horizontal">
                                <ImageView android:id="@+id/ivLoginBtnIcon" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_key_neo" android:tint="#07101B"/>
                                <TextView android:id="@+id/tvLoginBtnText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="9dp" android:text="CHECK KEY" android:textColor="#07101B" android:textSize="14sp" android:textStyle="bold" android:letterSpacing="0.12"/>
                                <ProgressBar android:id="@+id/progressLogin" android:layout_width="22dp" android:layout_height="22dp" android:visibility="gone" android:indeterminateTint="@color/neo_bg"/>
                            </LinearLayout>
                        </FrameLayout>
                        <FrameLayout android:id="@+id/btnGetKeyFree" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:background="@drawable/bg_neo_button_free" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackgroundBorderless">
                            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center_vertical" android:orientation="horizontal">
                                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_key_neo" android:tint="@color/white"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="GET KEY FREE" android:textColor="@color/white" android:textSize="13sp" android:textStyle="bold" android:letterSpacing="0.08"/>
                            </LinearLayout>
                        </FrameLayout>
                    </LinearLayout>
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <FrameLayout android:id="@+id/btnLoginGoogle" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:background="@drawable/bg_neo_card" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackgroundBorderless">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center_vertical" android:orientation="horizontal"><ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_google_g"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="@string/login_google" android:textColor="@color/neo_text" android:textSize="13sp" android:textStyle="bold"/></LinearLayout>
            </FrameLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
                <FrameLayout android:id="@+id/cardFacebook" android:layout_width="0dp" android:layout_height="68dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:background="@drawable/bg_neo_card" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackgroundBorderless">
                    <com.aujunpeak.app.views.ParticleView android:id="@+id/fbParticles" android:layout_width="match_parent" android:layout_height="match_parent" android:alpha="0.18"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Facebook" android:textColor="#6DA7FF" android:textSize="13sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Official support" android:textColor="@color/neo_text_3" android:textSize="9sp"/></LinearLayout>
                </FrameLayout>
                <FrameLayout android:id="@+id/cardZalo" android:layout_width="0dp" android:layout_height="68dp" android:layout_weight="1" android:layout_marginStart="6dp" android:background="@drawable/bg_neo_card" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackgroundBorderless">
                    <com.aujunpeak.app.views.ParticleView android:id="@+id/zaloParticles" android:layout_width="match_parent" android:layout_height="match_parent" android:alpha="0.18"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Zalo" android:textColor="@color/neo_cyan" android:textSize="13sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Quick support" android:textColor="@color/neo_text_3" android:textSize="9sp"/></LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
