<?xml version='1.0' encoding='UTF-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/rootCrosshairCard" android:layout_width="0dp" android:layout_height="92dp" android:layout_weight="1" android:layout_margin="4dp" android:background="@drawable/bg_crosshair_card_glass" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical" android:foreground="?attr/selectableItemBackground">
    <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_neo_icon_plate">
        <View android:id="@+id/vChCardRing" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_orbital_ring" android:alpha="0.55"/>
        <ImageView android:id="@+id/ivChCardIcon" android:layout_width="23dp" android:layout_height="23dp" android:layout_gravity="center" android:src="@drawable/ic_crosshair_dot" android:tint="@color/neo_cyan"/>
    </FrameLayout>
    <TextView android:id="@+id/tvChCardLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:maxLines="1" android:text="LABEL" android:textColor="@color/white" android:textSize="11sp" android:textStyle="bold" android:includeFontPadding="false"/>
</LinearLayout>
