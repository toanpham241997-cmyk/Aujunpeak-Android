<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_history_item"
    android:padding="12dp"
    android:gravity="center_vertical"
    android:layout_marginBottom="8dp">

    <!-- Index badge / icon -->
    <FrameLayout
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginEnd="12dp">
        <View
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_ff_switch_icon_card"/>
        <ImageView
            android:id="@+id/ivHistoryIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_key_glow"/>
    </FrameLayout>

    <!-- Info block -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Device name -->
        <TextView
            android:id="@+id/tvHistoryDevice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Samsung Galaxy S24"
            android:textColor="#DDFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="3dp"
            android:maxLines="1"
            android:ellipsize="end"/>

        <!-- Time -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="3dp">
            <ImageView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:src="@drawable/ic_time_online"
                android:tint="#FF9800"
                android:layout_marginEnd="4dp"/>
            <TextView
                android:id="@+id/tvHistoryTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12/07/2025 14:30"
                android:textColor="#AAFF9800"
                android:textSize="11sp"/>
        </LinearLayout>

        <!-- IP + Country row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:src="@drawable/ic_ip_address"
                android:tint="#2196F3"
                android:layout_marginEnd="4dp"/>
            <TextView
                android:id="@+id/tvHistoryIp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="123.45.67.89"
                android:textColor="#AA2196F3"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="end"/>
            <ImageView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:src="@drawable/ic_globe_country"
                android:tint="#69FF47"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="4dp"/>
            <TextView
                android:id="@+id/tvHistoryCountry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vietnam"
                android:textColor="#AA69FF47"
                android:textSize="10sp"/>
        </LinearLayout>

    </LinearLayout>

    <!-- Session index badge -->
    <TextView
        android:id="@+id/tvHistoryIndex"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:gravity="center"
        android:text="#1"
        android:textColor="#882196F3"
        android:textSize="9sp"
        android:textStyle="bold"/>

</LinearLayout>
