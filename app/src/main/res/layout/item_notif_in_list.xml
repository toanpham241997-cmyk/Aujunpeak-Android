<?xml version='1.0' encoding='UTF-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:background="@drawable/bg_notif_list_item" android:gravity="top" android:orientation="horizontal" android:padding="10dp">

    <FrameLayout android:layout_width="16dp" android:layout_height="16dp" android:layout_marginTop="3dp" android:layout_marginEnd="10dp">
        <View android:layout_width="16dp" android:layout_height="16dp" android:background="@drawable/bg_neo_glow_cyan" android:alpha="0.16"/>
        <View android:id="@+id/notifItemUnreadDot" android:layout_width="9dp" android:layout_height="9dp" android:layout_gravity="center" android:background="@drawable/bg_notif_green_dot"/>
    </FrameLayout>

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tvNotifItemTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#F3F8FF" android:textSize="13sp" android:textStyle="bold" android:includeFontPadding="false"/>
        <TextView android:id="@+id/tvNotifItemBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:ellipsize="end" android:lineSpacingMultiplier="1.2" android:maxLines="3" android:textColor="#AEBFDA" android:textSize="11.5sp" android:includeFontPadding="false"/>
        <TextView android:id="@+id/tvNotifItemTime" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="#73F7B0" android:textSize="11sp" android:textStyle="bold" android:includeFontPadding="false"/>
    </LinearLayout>
</LinearLayout>
