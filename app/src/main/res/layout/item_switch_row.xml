<?xml version='1.0' encoding='UTF-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="66dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="8dp" android:background="@drawable/bg_neo_card">
    <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_neo_icon_plate">
        <View android:id="@+id/vIconRing" android:layout_width="42dp" android:layout_height="42dp" android:layout_gravity="center" android:background="@drawable/bg_orbital_ring" android:alpha="0.45"/>
        <ImageView android:id="@+id/ivSwitchIcon" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:contentDescription="@null"/>
    </FrameLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
        <TextView android:id="@+id/tvSwitchTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/neo_text" android:textSize="13sp" android:textStyle="bold" android:includeFontPadding="false"/>
        <TextView android:id="@+id/tvSwitchSub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="@color/neo_text_3" android:textSize="11.5sp" android:includeFontPadding="false"/>
    </LinearLayout>
    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/materialSwitch" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
</LinearLayout>
