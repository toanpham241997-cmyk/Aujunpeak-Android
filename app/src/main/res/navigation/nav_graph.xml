<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/navigation_info">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.aujunpeak.app.fragments.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home"
        xmlns:tools="http://schemas.android.com/tools">
        <action
            android:id="@+id/action_home_to_login"
            app:destination="@id/navigation_login"
            app:enterAnim="@anim/slide_up"
            app:exitAnim="@anim/fade_in"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/slide_up"/>
    </fragment>

    <fragment
        android:id="@+id/navigation_game"
        android:name="com.aujunpeak.app.fragments.GameFragment"
        android:label="Game"
        tools:layout="@layout/fragment_game"
        xmlns:tools="http://schemas.android.com/tools"/>

    <fragment
        android:id="@+id/navigation_function"
        android:name="com.aujunpeak.app.fragments.FunctionFragment"
        android:label="Function"
        tools:layout="@layout/fragment_function"
        xmlns:tools="http://schemas.android.com/tools"/>

    <fragment
        android:id="@+id/navigation_settings"
        android:name="com.aujunpeak.app.fragments.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings"
        xmlns:tools="http://schemas.android.com/tools"/>

    <fragment
        android:id="@+id/navigation_info"
        android:name="com.aujunpeak.app.fragments.InfoFragment"
        android:label="Info"
        tools:layout="@layout/fragment_info"
        xmlns:tools="http://schemas.android.com/tools">
        <action
            android:id="@+id/action_info_to_login"
            app:destination="@id/navigation_login"
            app:enterAnim="@anim/slide_up"
            app:exitAnim="@anim/fade_in"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/slide_up"/>
    </fragment>

    <fragment
        android:id="@+id/navigation_login"
        android:name="com.aujunpeak.app.fragments.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login"
        xmlns:tools="http://schemas.android.com/tools"/>

</navigation>
